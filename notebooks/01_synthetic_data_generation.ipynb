"""
generate_data.py
Synthetic EHR Generator for Inpatient Rehabilitation Analytics.
Includes domain-informed clinical distributions and synthetic data quality anomalies.
"""

import os
from datetime import datetime, timedelta
import numpy as np
import pandas as pd

# 设置随机种子以确保数据可完全复现
SEED = 42
np.random.seed(SEED)

OUTPUT_DIR = "../data/raw"
os.makedirs(OUTPUT_DIR, exist_ok=True)

N_PATIENTS = 420
N_ENCOUNTERS = 500  # 允许部分患者存在多次住院 (Re-admission)

# ==========================================
# 1. 生成 Patients 表 (Patient-level)
# ==========================================
patient_ids = [f"P{str(i).zfill(4)}" for i in range(1, N_PATIENTS + 1)]
genders = np.random.choice(["Female", "Male"], size=N_PATIENTS, p=[0.48, 0.52])

# 年龄分布：以老年康复人群为主 (均值 64 岁，标差 12)
base_dates = [
    datetime(2026, 1, 1) - timedelta(days=int(np.random.normal(64, 12) * 365.25))
    for _ in range(N_PATIENTS)
]
dobs = [d.strftime("%Y-%m-%d") for d in base_dates]

df_patients = pd.DataFrame(
    {"patient_id": patient_ids, "gender": genders, "date_of_birth": dobs}
)

# ==========================================
# 2. 生成 Encounters 表 (Encounter-level)
# ==========================================
# 随机分配患者住院事件
enc_patient_ids = np.random.choice(patient_ids, size=N_ENCOUNTERS, replace=True)
encounter_ids = [f"E{str(i).zfill(5)}" for i in range(1, N_ENCOUNTERS + 1)]

departments = []
diagnoses = []
adm_dates = []
dis_dates = []
los_days_list = []
dispositions = []

study_start = datetime(2025, 1, 1)

for i in range(N_ENCOUNTERS):
    # 诊断分组逻辑
    dept = np.random.choice(["Neurological", "Orthopedic"], p=[0.55, 0.45])
    departments.append(dept)

    if dept == "Neurological":
        diag = np.random.choice(
            ["Ischemic Stroke", "Hemorrhagic Stroke", "Spinal Cord Injury"],
            p=[0.70, 0.20, 0.10],
        )
        # 神经康复住院日较长 (Log-normal 分布，中位数约 28 天)
        los = int(np.random.lognormal(mean=3.2, sigma=0.4))
    else:
        diag = np.random.choice(
            [
                "Hip Replacement Post-Op",
                "Knee Replacement Post-Op",
                "Femoral Fracture",
            ],
            p=[0.45, 0.40, 0.15],
        )
        # 骨科康复恢复较快，住院日较短 (中位数约 16 天)
        los = int(np.random.lognormal(mean=2.7, sigma=0.35))

    los = max(3, los)  # 至少住院 3 天
    diagnoses.append(diag)
    los_days_list.append(los)

    # 入院日期在 2025 年间随机分布
    random_days = np.random.randint(0, 360)
    adm_dt = study_start + timedelta(days=random_days)
    dis_dt = adm_dt + timedelta(days=los)

    adm_dates.append(adm_dt.strftime("%Y-%m-%d"))
    dis_dates.append(dis_dt.strftime("%Y-%m-%d"))

    # 出院去向
    disp = np.random.choice(
        ["Home Community", "Subacute Rehab", "Acute Care Readmission"],
        p=[0.82, 0.12, 0.06],
    )
    dispositions.append(disp)

df_encounters = pd.DataFrame(
    {
        "encounter_id": encounter_ids,
        "patient_id": enc_patient_ids,
        "department": departments,
        "primary_diagnosis": diagnoses,
        "admission_date": adm_dates,
        "discharge_date": dis_dates,
        "los_days": los_days_list,
        "discharge_disposition": dispositions,
    }
)

# ==========================================
# 3. 生成 Functional Assessments 表 (Domain-inspired)
# ==========================================
# 四个细分维度：Mobility(0-10), Transfer(0-10), Balance(0-10), ADL(0-20)，总分 50 分
assessments = []
assessment_counter = 1

for idx, row in df_encounters.iterrows():
    enc_id = row["encounter_id"]
    dept = row["department"]
    los = row["los_days"]
    adm_dt = datetime.strptime(row["admission_date"], "%Y-%m-%d")
    dis_dt = datetime.strptime(row["discharge_date"], "%Y-%m-%d")

    # 基线评估 (入院后 24-48 小时内完成)
    eval_adm_dt = adm_dt + timedelta(days=np.random.choice([0, 1]))

    if dept == "Neurological":
        # 神经受损患者基线更差
        adm_mob = np.random.randint(1, 5)
        adm_trans = np.random.randint(1, 5)
        adm_bal = np.random.randint(1, 4)
        adm_adl = np.random.randint(2, 8)
        # 神经恢复受 LOS 边际效应递减规律影响
        gain_factor = min(1.0, los / 35.0)
        gain = int(np.random.normal(12, 4) * gain_factor)
    else:
        # 骨科患者基线略好，主要受制于转移和移动
        adm_mob = np.random.randint(2, 6)
        adm_trans = np.random.randint(1, 5)
        adm_bal = np.random.randint(3, 7)
        adm_adl = np.random.randint(6, 12)
        gain_factor = min(1.0, los / 20.0)
        gain = int(np.random.normal(15, 3) * gain_factor)

    gain = max(0, gain)  # 功能评分不出现倒退（除异常外）
    adm_total = adm_mob + adm_trans + adm_bal + adm_adl

    # 存入院记录
    assessments.append(
        {
            "assessment_id": f"A{str(assessment_counter).zfill(6)}",
            "encounter_id": enc_id,
            "assessment_stage": "Admission",
            "assessment_date": eval_adm_dt.strftime("%Y-%m-%d"),
            "mobility_score": adm_mob,
            "transfer_score": adm_trans,
            "balance_score": adm_bal,
            "adl_score": adm_adl,
            "total_functional_score": adm_total,
        }
    )
    assessment_counter += 1

    # 出院评估 (出院前 24 小时内完成)
    eval_dis_dt = dis_dt - timedelta(days=np.random.choice([0, 1]))
    dis_total = min(50, adm_total + gain)

    # 将 gain 按比例分摊到各子项并设置上限
    d_mob = min(10, adm_mob + int(gain * 0.25))
    d_trans = min(10, adm_trans + int(gain * 0.25))
    d_bal = min(10, adm_bal + int(gain * 0.20))
    d_adl = min(20, dis_total - (d_mob + d_trans + d_bal))

    assessments.append(
        {
            "assessment_id": f"A{str(assessment_counter).zfill(6)}",
            "encounter_id": enc_id,
            "assessment_stage": "Discharge",
            "assessment_date": eval_dis_dt.strftime("%Y-%m-%d"),
            "mobility_score": d_mob,
            "transfer_score": d_trans,
            "balance_score": d_bal,
            "adl_score": d_adl,
            "total_functional_score": dis_total,
        }
    )
    assessment_counter += 1

df_assessments = pd.DataFrame(assessments)

# ==========================================
# 4. 生成 Rehab Sessions 表 (Treatment Intensity)
# ==========================================
sessions = []
session_counter = 1

for idx, row in df_encounters.iterrows():
    enc_id = row["encounter_id"]
    los = row["los_days"]
    dept = row["department"]
    adm_dt = datetime.strptime(row["admission_date"], "%Y-%m-%d")

    # 模拟工作日康复排班（每周平均 5 天有治疗）
    for day_offset in range(1, los):
        current_date = adm_dt + timedelta(days=day_offset)
        if current_date.weekday() >= 5:  # 周末减少排班
            if np.random.rand() > 0.3:
                continue

        # 治疗项目类型分配
        if dept == "Neurological":
            therapies = ["PT", "OT", "ST"]
            p_therapy = [0.45, 0.35, 0.20]
        else:
            therapies = ["PT", "OT"]
            p_therapy = [0.70, 0.30]

        # 当天可能安排 1-2 次不同类型的治疗
        n_sessions = np.random.choice([1, 2], p=[0.6, 0.4])
        chosen_therapies = np.random.choice(
            therapies, size=n_sessions, replace=False, p=p_therapy
        )

        for th in chosen_therapies:
            # 常见治疗时长：30分钟、45分钟或 60分钟
            duration = np.random.choice([30, 45, 60], p=[0.3, 0.5, 0.2])
            sessions.append(
                {
                    "session_id": f"S{str(session_counter).zfill(7)}",
                    "encounter_id": enc_id,
                    "session_date": current_date.strftime("%Y-%m-%d"),
                    "therapy_type": th,
                    "duration_minutes": duration,
                }
            )
            session_counter += 1

df_sessions = pd.DataFrame(sessions)

# ==========================================
# 5. 注入数据质量异常（用于清洗 Notebook 展现审计能力）
# ==========================================
print("Injecting synthetic data quality issues for validation auditing...")

# (1) 注入 5 条 Encounters 重复记录 (Duplicate encounters)
duplicates = df_encounters.sample(5, random_state=SEED)
df_encounters = pd.concat([df_encounters, duplicates], ignore_index=True)

# (2) 制造 4 条出院时间缺失 (Missing discharge dates)
missing_dis_idx = np.random.choice(df_encounters.index, size=4, replace=False)
df_encounters.loc[missing_dis_idx, "discharge_date"] = np.nan

# (3) 制造 3 条逻辑错误的住院日 (Invalid LOS: <= 0)
invalid_los_idx = np.random.choice(df_encounters.index, size=3, replace=False)
df_encounters.loc[invalid_los_idx, "los_days"] = -1

# (4) 制造 8 次评估缺失 (缺失出院评估，模拟患者非计划转出急诊或断联)
missing_asm_enc = np.random.choice(encounter_ids, size=8, replace=False)
df_assessments = df_assessments[
    ~(
        (df_assessments["encounter_id"].isin(missing_asm_enc))
        & (df_assessments["assessment_stage"] == "Discharge")
    )
]

# (5) 制造 10 次治疗会话的异常超长工时 (Duration = 999 录入错误)
invalid_dur_idx = np.random.choice(df_sessions.index, size=10, replace=False)
df_sessions.loc[invalid_dur_idx, "duration_minutes"] = 999

# ==========================================
# 6. 保存原始数据文件 (Raw CSVs)
# ==========================================
df_patients.to_csv(f"{OUTPUT_DIR}/patients.csv", index=False)
df_encounters.to_csv(f"{OUTPUT_DIR}/encounters.csv", index=False)
df_assessments.to_csv(f"{OUTPUT_DIR}/functional_assessments.csv", index=False)
df_sessions.to_csv(f"{OUTPUT_DIR}/rehab_sessions.csv", index=False)

print(f"Data generation complete. Files saved to {OUTPUT_DIR}:")
print(f"  - patients.csv:               {df_patients.shape}")
print(f"  - encounters.csv:             {df_encounters.shape}")
print(f"  - functional_assessments.csv: {df_assessments.shape}")
print(f"  - rehab_sessions.csv:         {df_sessions.shape}")
